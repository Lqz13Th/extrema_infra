+        }"#;
+
+        let decoded = decode_single_ws_frame::<TestPayload>(frame).unwrap();
+
+        match decoded {
+            GateWsData::Event(event) => {
+                assert_eq!(event.channel.as_deref(), Some("futures.book_ticker"));
+                assert_eq!(event.event.as_deref(), Some("subscribe"));
