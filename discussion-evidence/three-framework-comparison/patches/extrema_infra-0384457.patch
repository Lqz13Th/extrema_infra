+fn decode_preferred_ws_frame<T, Message>(
+    frame: &[u8],
+    wrap: fn(Message) -> BinanceWsData<T>,
+) -> serde_json::Result<BinanceWsData<T>>
+where
+    T: DeserializeOwned,
+    Message: DeserializeOwned,
+{
+    match serde_json::from_slice::<Message>(frame) {
+        Ok(message) => Ok(wrap(message)),
+        Err(_) => serde_json::from_slice(frame),
+    }
+}
+
+pub(crate) fn decode_single_ws_frame<T: DeserializeOwned>(
+    frame: &[u8],
+) -> serde_json::Result<BinanceWsData<T>> {
+    decode_preferred_ws_frame::<T, T>(frame, BinanceWsData::ChannelSingle)
